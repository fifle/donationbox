# HTTP configuration
#
server {
    listen 8080 default_server;
    listen [::]:8080 default_server;

    root /var/www/html/public;

    # Set allowed "index" files
    index index.html index.htm index.php;

    server_name _;

    charset utf-8;

    # Set max upload to 2048M
    client_max_body_size 2048M;

    # Prefer real visitor IP from Fly edge
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from fdaa::/16;
    real_ip_header Fly-Client-IP;
    real_ip_recursive on;

    # Soft per-IP throttle (burst absorbs page asset parallel loads)
    limit_req zone=db_perip burst=40 nodelay;
    limit_conn db_perip_conn 20;
    limit_req_status 429;
    limit_conn_status 429;

    # Drop common scanner paths before they hit Laravel
    location ~* ^/(?:wp-admin|wp-content|wp-includes|wp-login\.php|xmlrpc\.php|phpmyadmin|vendor/phpunit|cgi-bin|actuator)(?:/|$) {
        access_log off;
        log_not_found off;
        return 404;
    }

    # Have NGINX try searching for PHP files as well
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Only Laravel front controller may run PHP
    location = /index.php {
        include snippets/fastcgi-php.conf;
        fastcgi_param HTTP_X_FORWARDED_FOR $http_fly_client_ip;
        fastcgi_pass unix:/var/run/php/php-fpm.sock;
    }

    # Drop webshell / random *.php probes (no FPM, no Laravel, no log noise)
    location ~* \.php(?:$|/) {
        access_log off;
        log_not_found off;
        return 404;
    }

    # additional config
    include /etc/nginx/server-opts.d/*.conf;
}
